{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/*.css", "/*.js"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "hero-images",
      "urls": [
        "https://cdn.jsdelivr.net/gh/akabab/superhero-api*/**/*.jpg",
        "https://cdn.jsdelivr.net/gh/akabab/superhero-api*/**/*.png",
        "https://cdn.jsdelivr.net/gh/akabab/superhero-api*/**/*.webp"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "3s",
        "maxSize": 500,
        "maxAge": "30d",
        "cacheOpaqueResponses": true
      }
    }
  ]
}
